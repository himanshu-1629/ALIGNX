# =============================================================================
# ALIGNX — Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# =============================================================================

# Google Gemini LLM API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL_NAME="gemini-3.5-flash-lite"
GEMINI_TIMEOUT_SECONDS=10

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI="mongodb://localhost:27017/alignx"

# Application Environment & Server Settings
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"
